// Schema do site + painel administrativo da Dalami Confeitaria e Cafeteria.
//
// Princípio central: o admin edita CONTEÚDO dentro de campos pré-definidos.
// Não existe campo de HTML livre nem de posicionamento arbitrário. SiteSection
// controla quais seções aparecem na home e em que ordem, mas o layout interno
// de cada seção é fixo no código.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============================================================================
// MÍDIA
// ============================================================================

/// Guarda SOMENTE metadados. O arquivo binário nunca entra no Postgres: ele
/// vive no serviço de imagem externo (Cloudinary). `sizeBytes` é o tamanho do
/// arquivo JÁ OTIMIZADO, não o do original enviado, e serve como sinal de
/// saúde da pipeline de compressão.
model Media {
  id           String   @id @default(cuid())
  url          String
  /// Texto alternativo, obrigatório por acessibilidade.
  altText      String
  width        Int
  height       Int
  sizeBytes    Int
  /// Rótulo livre de onde a imagem é usada: "product", "hero", "logo", ...
  usageContext String   @default("product")
  createdAt    DateTime @default(now())

  categories      Category[]
  products        Product[]
  highlights      Highlight[]
  contentBlocks   ContentBlock[]
  settingsLogo    SiteSettings[] @relation("SettingsLogo")
  settingsFavicon SiteSettings[] @relation("SettingsFavicon")
  settingsSeo     SiteSettings[] @relation("SettingsSeo")

  @@index([usageContext])
  @@index([createdAt])
}

// ============================================================================
// CARDÁPIO
// ============================================================================

model Category {
  id          String  @id @default(cuid())
  name        String
  slug        String  @unique
  description String?
  mediaId     String?
  order       Int     @default(0)
  active      Boolean @default(true)

  media    Media?    @relation(fields: [mediaId], references: [id], onDelete: SetNull)
  products Product[]

  @@index([order])
  @@index([active])
}

/// Modelo padrão de cardápio de cafeteria: um item, um preço.
/// Sem variantes de tamanho: essa ideia veio de um material de bolos por
/// encomenda que NÃO representa o cardápio real desta casa.
model Product {
  id          String    @id @default(cuid())
  categoryId  String
  name        String
  slug        String    @unique
  description String?
  /// Decimal, nunca Float: preço em dinheiro não pode sofrer erro de ponto flutuante.
  price       Decimal   @db.Decimal(10, 2)
  promoPrice  Decimal?  @db.Decimal(10, 2)
  promoStartsAt DateTime?
  promoEndsAt   DateTime?
  mediaId     String?
  featured    Boolean   @default(false)
  /// Cobre também o caso "não disponível hoje".
  available   Boolean   @default(true)
  order       Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  /// Restrict: apagar uma categoria que ainda tem produtos deve FALHAR com uma
  /// mensagem clara no admin, nunca apagar os produtos em silêncio.
  category   Category    @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  media      Media?      @relation(fields: [mediaId], references: [id], onDelete: SetNull)
  highlights Highlight[]

  @@index([categoryId, order])
  @@index([featured])
  @@index([available])
}

// ============================================================================
// CONTEÚDO DA HOME
// ============================================================================

enum HighlightKind {
  product
  custom_image
  custom_content
}

/// Um destaque aponta para um Product OU carrega conteúdo próprio, NUNCA os
/// dois. A regra é garantida em três camadas: o enum `kind`, um refine do Zod
/// no servidor, e um CHECK constraint no banco.
model Highlight {
  id            String        @id @default(cuid())
  kind          HighlightKind
  productId     String?
  mediaId       String?
  customTitle   String?
  customText    String?
  customLinkUrl String?
  order         Int           @default(0)
  active        Boolean       @default(true)
  startsAt      DateTime?
  endsAt        DateTime?

  product Product? @relation(fields: [productId], references: [id], onDelete: Cascade)
  media   Media?   @relation(fields: [mediaId], references: [id], onDelete: SetNull)

  @@index([order])
  @@index([active])
}

/// Blocos da seção "Sobre". O admin pode adicionar quantos quiser.
///
/// O LADO da imagem não é editável: ele sai da posição do bloco na lista
/// (`order` par = imagem à esquerda, ímpar = imagem à direita). É o mesmo
/// princípio do resto do admin, liberdade de conteúdo dentro de limites que
/// não deixam o layout quebrar.
///
/// `body` é texto rico LIMITADO (negrito, itálico, listas, links) e sanitizado
/// NO SERVIDOR antes de salvar, nunca HTML bruto vindo do cliente.
model ContentBlock {
  id      String  @id @default(cuid())
  key     String  @unique
  title   String?
  body    String?
  mediaId String?
  order   Int     @default(0)
  visible Boolean @default(true)

  media Media? @relation(fields: [mediaId], references: [id], onDelete: SetNull)

  @@index([order])
}

/// Controla QUAIS seções aparecem na home e em QUE ORDEM.
/// Chaves: "highlights" | "menu-cta" | "order-cta" | "about" | "location" |
///         "hours" | "contact"
/// O admin liga, desliga e reordena. O layout interno de cada seção é fixo no
/// código, então não há como quebrar a página.
model SiteSection {
  id      String  @id @default(cuid())
  key     String  @unique
  visible Boolean @default(true)
  order   Int     @default(0)

  @@index([order])
}

// ============================================================================
// ENCOMENDA
// ============================================================================

/// Singleton da seção "Fazer encomenda".
///
/// Nesta etapa é só texto + botão de WhatsApp. A seleção de quais itens do
/// cardápio ficam disponíveis para encomenda virá depois, numa tabela
/// OrderSectionItem (productId, order) que NÃO deve ser criada agora.
model OrderSection {
  id             String  @id @default("singleton")
  title          String  @default("Fazer encomenda")
  description    String?
  whatsappNumber String?
  active         Boolean @default(true)
}

// ============================================================================
// CONFIGURAÇÕES DO SITE
// ============================================================================

/// Singleton: existe exatamente UMA linha, com id fixo "singleton".
model SiteSettings {
  id              String  @id @default("singleton")
  siteName        String  @default("Dalami Confeitaria e Cafeteria")
  logoMediaId     String?
  faviconMediaId  String?
  seoTitle        String?
  seoDescription  String?
  seoImageMediaId String?
  footerText      String?
  /// Ex.: "Bairro Ingleses, Florianópolis - SC"
  locationRegion  String?
  /// Ex.: "Venha nos visitar!"
  locationNote    String?

  logoMedia     Media? @relation("SettingsLogo", fields: [logoMediaId], references: [id], onDelete: SetNull)
  faviconMedia  Media? @relation("SettingsFavicon", fields: [faviconMediaId], references: [id], onDelete: SetNull)
  seoImageMedia Media? @relation("SettingsSeo", fields: [seoImageMediaId], references: [id], onDelete: SetNull)
}

/// Lista aberta, sem colunas fixas por rede social.
model SocialLink {
  id       String  @id @default(cuid())
  platform String
  url      String
  icon     String?
  order    Int     @default(0)
  active   Boolean @default(true)

  @@index([order])
  @@index([active])
}

/// Canal de compra mostrado no cardápio, por exemplo o botão "Comprar no iFood".
/// Lista aberta para permitir outros canais no futuro. O site nunca faz
/// checkout próprio.
model OrderChannel {
  id         String  @id @default(cuid())
  name       String
  type       String
  urlOrPhone String
  icon       String?
  order      Int     @default(0)
  active     Boolean @default(true)

  @@index([order])
  @@index([active])
}

// ============================================================================
// HORÁRIOS
// ============================================================================

/// Horário semanal. `periodOrder` permite mais de um período no mesmo dia,
/// por exemplo 08:00-12:00 e 14:00-18:00.
///
/// opensAt/closesAt são String "HH:MM" de propósito: um tipo Time do Postgres
/// carregaria semântica de fuso, e o cálculo de "aberto agora" precisa rodar em
/// America/Sao_Paulo, não no fuso do servidor (o Render roda em UTC).
model BusinessHours {
  id          String  @id @default(cuid())
  /// 0 = domingo ... 6 = sábado
  dayOfWeek   Int
  opensAt     String?
  closesAt    String?
  periodOrder Int     @default(0)
  closed      Boolean @default(false)

  @@unique([dayOfWeek, periodOrder])
  @@index([dayOfWeek])
}

/// Exceções pontuais (feriados). Sobrepõem o BusinessHours daquela data.
model SpecialHours {
  id       String   @id @default(cuid())
  date     DateTime @unique @db.Date
  opensAt  String?
  closesAt String?
  closed   Boolean  @default(true)
  /// Ex.: "Feriado - Natal"
  label    String?

  @@index([date])
}
