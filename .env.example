# =============================================================================
# Copie este arquivo para `.env` e preencha os valores.
# O `.env` NUNCA deve ser versionado (já está no .gitignore).
# =============================================================================

# --- Banco de dados -----------------------------------------------------------
# Dev: Postgres local.
# Produção: use Supabase ou Neon. NÃO use o Postgres gratuito do Render — ele
# expira em 30 dias sem backup.
DATABASE_URL="postgresql://usuario:senha@localhost:5432/dalami?schema=public"

# --- Autenticação do admin ----------------------------------------------------
# Existe um único administrador. Não há tabela de usuários no banco.
# Gere o hash com: npm run admin:hash
ADMIN_USERNAME="admin"
ADMIN_PASSWORD_HASH=""

# Segredo usado para assinar o cookie de sessão.
# Gere um valor aleatório forte, por exemplo:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=""

# --- Storage de imagens -------------------------------------------------------
# "local"  -> grava em disco (apenas desenvolvimento)
# Em produção troque para o adaptador de nuvem escolhido e preencha as
# credenciais correspondentes. O filesystem do Render é efêmero: arquivos
# gravados localmente somem a cada redeploy.
STORAGE_DRIVER="local"

# --- Site ---------------------------------------------------------------------
# URL pública do site, usada em sitemap.xml, robots.txt e nas tags Open Graph.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
